<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- 카메라는 선택 기능(식단 사진 촬영) — 카메라 없는 기기에서도 설치 가능해야 한다. -->
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <application
        android:name=".DandiApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Dandi"
        android:usesCleartextTraffic="${usesCleartextTraffic}">
        <!--
          화면은 세로로 고정한다(가로 레이아웃을 따로 두지 않는다). 그래서 회전 고정 lint 경고는 끈다.
          Android 16 이상의 큰 화면(가장 짧은 변 600dp 이상)에서는 OS가 이 고정을 무시한다.
        -->
        <activity
            android:name="com.dandi.nyummy.main.presentation.MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.Dandi"
            tools:ignore="LockedOrientationActivity,DiscouragedApi">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data android:scheme="https" />
                <data android:host="link.nyummy.co.kr" />
            </intent-filter>
        </activity>

        <!-- 서버 푸시(FCM) 수신. 서버가 notification 블록을 함께 보내므로 앱이 켜져 있을 때만 불린다. -->
        <service
            android:name=".push.NyummyMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
        <!-- release 빌드에서만 true. app/build.gradle.kts 의 androidComponents 가 정한다. -->
        <meta-data
            android:name="firebase_performance_collection_enabled"
            android:value="${firebasePerformanceCollectionEnabled}" />
        <meta-data
            android:name="firebase_crashlytics_collection_enabled"
            android:value="${firebaseCrashlyticsCollectionEnabled}" />
        <meta-data
            android:name="firebase_analytics_collection_enabled"
            android:value="${firebaseAnalyticsCollectionEnabled}" />
        <!-- 화면은 모두 한 액티비티 안의 Compose 경로라 자동 화면 기록(액티비티 이름)은 끄고, 경로가 바뀔 때 직접 남긴다. -->
        <meta-data
            android:name="google_analytics_automatic_screen_reporting_enabled"
            android:value="false" />

        <!-- Meta 광고 설치 측정. 앱 ID와 토큰은 app/build.gradle.kts 가 local.properties 에서 넣는다. -->
        <meta-data
            android:name="com.facebook.sdk.ApplicationId"
            android:value="@string/facebook_app_id" />
        <meta-data
            android:name="com.facebook.sdk.ClientToken"
            android:value="@string/facebook_client_token" />
        <!-- 설치, 실행 자동 기록과 광고 ID 수집은 release 빌드에서만 true -->
        <meta-data
            android:name="com.facebook.sdk.AutoLogAppEventsEnabled"
            android:value="${metaAppEventsEnabled}" />
        <meta-data
            android:name="com.facebook.sdk.AdvertiserIDCollectionEnabled"
            android:value="${metaAppEventsEnabled}" />
        <!-- 설치 측정에 필요 없는 화면 제목, 화면 구성 수집은 끈다 -->
        <meta-data
            android:name="com.facebook.sdk.AutoLogMetaDataEnabled"
            android:value="false" />
        <meta-data
            android:name="com.facebook.sdk.AutoLogProductImprovementEnabled"
            android:value="false" />

        <!-- 앱이 백그라운드일 때 OS가 서버 푸시를 띄우는 기본 아이콘, 색, 채널 -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_stat_nyummy" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_color"
            android:resource="@color/notification_accent" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="nyummy_reminder" />
    </application>

</manifest>
