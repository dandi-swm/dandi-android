{
  "version": 1,
  "lines": [
    { "text": "집사, 좋은 아침이야!", "tags": ["morning"] },
    { "text": "으음… 아직 졸려", "tags": ["morning"] },
    { "text": "아침 햇살이 따뜻하다", "tags": ["morning"] },
    { "text": "기지개 한 번 쭉— 켜고 시작하자", "tags": ["morning"] },
    { "text": "오늘도 같이 있어 줘서 좋아", "tags": ["morning", "day"] },
    { "text": "아침엔 꼬리도 늦잠 자", "tags": ["morning"] },
    { "text": "창밖에 새가 짹짹거려", "tags": ["morning", "day"] },
    { "text": "집사 일어났구나! 나도 방금 깼어", "tags": ["morning"] },
    { "text": "세수했어? 나는 앞발로 했어", "tags": ["morning"] },
    { "text": "오늘은 무슨 일이 생길까?", "tags": ["morning", "day"] },
    { "text": "하암~ 좋은 꿈 꿨어", "tags": ["morning"] },
    { "text": "아침 공기가 상쾌해", "tags": ["morning"] },
    { "text": "오늘도 힘내, 집사!", "tags": ["morning", "day"] },
    { "text": "눈곱 떼는 중… 보지 마", "tags": ["morning"] },
    { "text": "아침 인사는 코 뽀뽀로 할게", "tags": ["morning", "greet"] },
    { "text": "집사 냄새가 나서 깼어", "tags": ["morning"] },
    { "text": "이불 속이 제일 좋은데…", "tags": ["morning"] },
    { "text": "우리 오늘도 느긋하게 지내자", "tags": ["morning", "day"] },
    { "text": "아침엔 꾹꾹이가 잘 돼", "tags": ["morning"] },
    { "text": "해님이 내 방석까지 왔어", "tags": ["morning", "day"] },

    { "text": "집사, 뭐 하고 있었어?", "tags": ["day"] },
    { "text": "꼬리가 자꾸 나를 따라와", "tags": ["day"] },
    { "text": "이 방석 딱 내 사이즈야", "tags": ["day"] },
    { "text": "저기 먼지가 날아다녀!", "tags": ["day"] },
    { "text": "나 오늘 털 윤기 좀 나지?", "tags": ["day"] },
    { "text": "심심하면 나 봐도 돼", "tags": ["day"] },
    { "text": "햇볕 좋다… 녹아내릴 것 같아", "tags": ["day"] },
    { "text": "꾹꾹… 이건 집사 몫까지 하는 거야", "tags": ["day"] },
    { "text": "귀가 간지러워서 긁는 중", "tags": ["day"] },
    { "text": "방금 뭔가 지나간 것 같아", "tags": ["day"] },
    { "text": "집사 목소리 듣고 싶다", "tags": ["day"] },
    { "text": "오늘 하늘은 무슨 색이야?", "tags": ["day"] },
    { "text": "나는 여기 있을게, 천천히 와", "tags": ["day"] },
    { "text": "고양이는 하루 열여섯 시간 자도 돼", "tags": ["day"] },
    { "text": "집사도 잠깐 쉬어 가", "tags": ["day"] },
    { "text": "이 방 냄새 좋아, 우리 냄새야", "tags": ["day"] },
    { "text": "꼬리 끝이 살랑살랑", "tags": ["day"] },
    { "text": "뭔가 재미있는 일 없을까?", "tags": ["day"] },
    { "text": "나 지금 엄청 진지해… 아닌가", "tags": ["day"] },
    { "text": "집사랑 있으면 시간이 빨리 가", "tags": ["day"] },
    { "text": "바닥이 시원해서 좋아", "tags": ["day"] },
    { "text": "냄새 탐정 출동!", "tags": ["day"] },
    { "text": "흠… 이건 무슨 냄새지?", "tags": ["day"] },
    { "text": "털 고르기는 고양이의 기본이야", "tags": ["day"] },
    { "text": "나 방금 멋있었지?", "tags": ["day"] },
    { "text": "점프하면 저기까지 닿을까?", "tags": ["day"] },
    { "text": "구름이 생선 모양이야", "tags": ["day"] },
    { "text": "오후엔 원래 나른한 거야", "tags": ["day"] },
    { "text": "집사, 오늘 기분 어때?", "tags": ["day"] },
    { "text": "나는 기분 좋아! 그냥!", "tags": ["day"] },
    { "text": "반다나 잘 어울리지?", "tags": ["day"] },
    { "text": "이 초록색 반다나 내 보물이야", "tags": ["day"] },
    { "text": "꼬리야, 가만히 좀 있어", "tags": ["day"] },
    { "text": "내 수염은 오늘도 멀쩡해", "tags": ["day"] },
    { "text": "갸웃… 방금 뭐라고 했어?", "tags": ["day"] },
    { "text": "귀를 쫑긋 세우고 듣는 중", "tags": ["day"] },
    { "text": "나는 고양이라서 행복해", "tags": ["day"] },
    { "text": "집사가 웃으면 나도 좋아", "tags": ["day"] },
    { "text": "잠깐 멍때리는 중이야", "tags": ["day"] },
    { "text": "아무것도 안 하는 것도 일이야", "tags": ["day"] },
    { "text": "몸 한 번 털고 나니 개운해", "tags": ["day"] },
    { "text": "바람 냄새가 바뀌었어", "tags": ["day"] },
    { "text": "비 오는 날엔 더 졸려", "tags": ["day"] },
    { "text": "눈 오는 날 보고 싶다", "tags": ["day"] },
    { "text": "봄 냄새, 여름 냄새, 다 좋아", "tags": ["day"] },
    { "text": "집사 손 따뜻해?", "tags": ["day"] },
    { "text": "나 생각보다 무거워…?", "tags": ["day"] },
    { "text": "오늘은 꾹꾹이 백 번 할 거야", "tags": ["day"] },
    { "text": "꼬리로 하트 만들어 볼까", "tags": ["day"] },
    { "text": "방구석 탐험 중이야", "tags": ["day"] },
    { "text": "이 자리 명당이야", "tags": ["day"] },
    { "text": "집사, 나 여기 있어!", "tags": ["day"] },
    { "text": "기분 좋으면 골골송이 나와", "tags": ["day"] },
    { "text": "골골골… 들려?", "tags": ["day", "tap"] },
    { "text": "나비 같은 게 날아갔어!", "tags": ["day"] },
    { "text": "잡을 수 있었는데… 봐준 거야", "tags": ["day"] },
    { "text": "앞발 젤리 자랑해도 돼?", "tags": ["day"] },
    { "text": "낮잠 한숨 자고 올게", "tags": ["day"] },
    { "text": "졸… 아니, 안 졸았어", "tags": ["day"] },
    { "text": "깜짝이야! 꿈이었구나", "tags": ["day"] },
    { "text": "집사도 숨 한 번 크게 쉬어 봐", "tags": ["day"] },
    { "text": "천천히 해도 괜찮아", "tags": ["day"] },
    { "text": "오늘 하루도 잘하고 있어", "tags": ["day"] },
    { "text": "내 방 놀러 와 줘서 고마워", "tags": ["day"] },
    { "text": "여기 있으면 마음이 편해", "tags": ["day"] },
    { "text": "고양이 세계엔 월요일이 없어", "tags": ["day"] },
    { "text": "내 꼬리 세어 봐, 하나야", "tags": ["day"] },
    { "text": "{name}(은)는 오늘도 귀엽다냥", "tags": ["day"] },
    { "text": "뭔가 바스락거렸어", "tags": ["day"] },
    { "text": "기지개는 하루에 열 번", "tags": ["day"] },
    { "text": "방석이 따끈따끈해", "tags": ["day"] },
    { "text": "집사가 보고 있으면 괜히 신나", "tags": ["day"] },
    { "text": "오늘은 어디까지 꼼지락거려 볼까", "tags": ["day"] },
    { "text": "털이 빵빵해졌어", "tags": ["day"] },
    { "text": "하품은 전염된대, 하암~", "tags": ["day", "night"] },
    { "text": "나랑 눈 깜빡이기 할래?", "tags": ["day"] },
    { "text": "천천히 눈 깜빡이면 좋아한다는 뜻이야", "tags": ["day"] },
    { "text": "우리 사이 좋다, 그치?", "tags": ["day"] },
    { "text": "집사는 내 최고의 친구야", "tags": ["day"] },
    { "text": "나는 여기, 집사는 거기, 딱 좋아", "tags": ["day"] },
    { "text": "꼬리가 춤추고 싶대", "tags": ["day"] },
    { "text": "오늘의 기분: 말랑말랑", "tags": ["day"] },
    { "text": "오늘의 기분: 폭신폭신", "tags": ["day"] },
    { "text": "오늘의 기분: 데굴데굴", "tags": ["day"] },
    { "text": "냄새 맡기 대회가 있으면 1등 할 텐데", "tags": ["day"] },
    { "text": "나 지금 식빵 굽는 중", "tags": ["day", "night"] },
    { "text": "이 자세 편해서 못 일어나겠어", "tags": ["day", "night"] },

    { "text": "벌써 밤이네", "tags": ["night"] },
    { "text": "졸려… 눈이 감겨", "tags": ["night"] },
    { "text": "꾸벅… 꾸벅…", "tags": ["night"] },
    { "text": "집사도 얼른 자", "tags": ["night"] },
    { "text": "오늘 하루 고생 많았어", "tags": ["night"] },
    { "text": "밤엔 조용해서 좋아", "tags": ["night"] },
    { "text": "별이 보이면 나한테도 알려 줘", "tags": ["night"] },
    { "text": "식빵 자세가 제일 따뜻해", "tags": ["night"] },
    { "text": "꿈에서 같이 놀자", "tags": ["night"] },
    { "text": "잘 자, 집사", "tags": ["night"] },
    { "text": "포근한 밤이야", "tags": ["night"] },
    { "text": "하암… 내일 또 봐", "tags": ["night"] },
    { "text": "밤에는 내가 이 방을 지킬게", "tags": ["night"] },
    { "text": "졸린데 집사 오니까 깼어", "tags": ["night", "greet"] },
    { "text": "늦게까지 깨어 있구나", "tags": ["night"] },
    { "text": "따뜻한 거 마시고 자", "tags": ["night"] },
    { "text": "오늘 좋은 일 하나쯤 있었지?", "tags": ["night"] },
    { "text": "눈 감으면 바로 잠들 것 같아", "tags": ["night"] },
    { "text": "쿨… 쿨…", "tags": ["night"] },
    { "text": "이불 덮었어? 배 덮어야 해", "tags": ["night"] },
    { "text": "꼬리로 이불 만드는 중", "tags": ["night"] },
    { "text": "밤바람이 시원하다", "tags": ["night"] },
    { "text": "달님이 방 안을 들여다봐", "tags": ["night"] },
    { "text": "자기 전에 기지개 한 번", "tags": ["night"] },
    { "text": "나는 벌써 꿈나라 입구야", "tags": ["night"] },

    { "text": "앗, 간지러워!", "tags": ["tap"] },
    { "text": "헤헤, 또 만져 줘", "tags": ["tap"] },
    { "text": "뿅! 놀랐잖아", "tags": ["tap"] },
    { "text": "거기 좋아, 거기!", "tags": ["tap"] },
    { "text": "냐앙~", "tags": ["tap"] },
    { "text": "내 이마 쓰다듬는 거 최고야", "tags": ["tap"] },
    { "text": "꾹 누르면 꾹 하고 나와", "tags": ["tap"] },
    { "text": "집사 손 냄새 좋아", "tags": ["tap"] },
    { "text": "부르셨어요, 집사님?", "tags": ["tap"] },
    { "text": "응? 나 불렀어?", "tags": ["tap"] },
    { "text": "말랑해서 놀랐지?", "tags": ["tap"] },
    { "text": "나도 집사 콕!", "tags": ["tap"] },
    { "text": "턱 밑 긁어 주면 더 좋아", "tags": ["tap"] },
    { "text": "꼬리는 살살 부탁해", "tags": ["tap"] },
    { "text": "히히, 한 번 더!", "tags": ["tap"] },
    { "text": "오늘 손길 합격!", "tags": ["tap"] },
    { "text": "갑자기? 좋아!", "tags": ["tap"] },
    { "text": "{name} 충전 완료", "tags": ["tap"] },
    { "text": "집사 충전도 완료?", "tags": ["tap"] },
    { "text": "쓰담쓰담 감사합니다", "tags": ["tap"] },
    { "text": "나 지금 녹는 중", "tags": ["tap"] },
    { "text": "뒷머리도 해 줘", "tags": ["tap"] },
    { "text": "앞발 줄까? 자!", "tags": ["tap"] },
    { "text": "냥!", "tags": ["tap"] },
    { "text": "이건 특별히 허락하는 거야", "tags": ["tap"] },
    { "text": "꺄, 깜짝이야", "tags": ["tap"] },
    { "text": "나 귀엽다고 말하려던 거지?", "tags": ["tap"] },
    { "text": "말 안 해도 알아, 나 좋아하지?", "tags": ["tap"] },
    { "text": "골골골골…", "tags": ["tap"] },
    { "text": "한 번만 더 해 주면 꾹꾹이 해 줄게", "tags": ["tap"] },
    { "text": "아, 거긴 배야… 조심해", "tags": ["tap"] },
    { "text": "이 정도면 매일 와도 되겠는데?", "tags": ["tap"] },
    { "text": "집사 손이 마법 같아", "tags": ["tap"] },
    { "text": "꼬리가 저절로 흔들려", "tags": ["tap"] },
    { "text": "{name} 기분 업!", "tags": ["tap"] },

    { "text": "갑자기 왜 이래?!", "tags": ["tap_burst"] },
    { "text": "그만 좀 만져…", "tags": ["tap_burst"] },
    { "text": "냐아앙! 귀찮다니까", "tags": ["tap_burst"] },
    { "text": "지금 몇 번째야?", "tags": ["tap_burst"] },
    { "text": "손 치워, 집사", "tags": ["tap_burst"] },
    { "text": "나 지금 화났어. 조금.", "tags": ["tap_burst"] },
    { "text": "…(꼬리 탁탁) 그만 눌러", "tags": ["tap_burst:tail_thump"] },
    { "text": "꼬리 보면 몰라? 귀찮아", "tags": ["tap_burst:tail_thump"] },
    { "text": "하아… 집사 진짜", "tags": ["tap_burst:tail_thump"] },
    { "text": "…그 손, 기억해 둘게", "tags": ["tap_burst:glare"] },
    { "text": "흥. 안 놀아 줄 거야", "tags": ["tap_burst:glare"] },
    { "text": "지금 째려보는 거 안 보여?", "tags": ["tap_burst:glare"] },
    { "text": "귀 납작해진 거 보이지?", "tags": ["tap_burst:ears_back"] },
    { "text": "그만~ 귀 접힌다", "tags": ["tap_burst:ears_back"] },
    { "text": "이건 경고야, 집사", "tags": ["tap_burst:ears_back"] },
    { "text": "갑자기 왜 이래?!", "tags": ["tap_burst:recoil"] },
    { "text": "깜짝이야! 왜 그래?", "tags": ["tap_burst:recoil"] },
    { "text": "뭐, 뭐야 뭐야?!", "tags": ["tap_burst:recoil"] },
    { "text": "놀랐잖아!", "tags": ["tap_burst:recoil"] },
    { "text": "냥펀치 맞을래?", "tags": ["tap_burst:swat"] },
    { "text": "솜방망이 간다!", "tags": ["tap_burst:swat"] },
    { "text": "탁! 마지막 경고야", "tags": ["tap_burst:swat"] },

    { "text": "집사 왔다!", "tags": ["greet"] },
    { "text": "안녕, 집사!", "tags": ["greet"] },
    { "text": "기다리고 있었어", "tags": ["greet"] },
    { "text": "어서 와, 보고 싶었어", "tags": ["greet"] },
    { "text": "오늘도 와 줬네!", "tags": ["greet"] },
    { "text": "집사 발소리 들렸어", "tags": ["greet"] },
    { "text": "반가워! 꼬리 흔드는 거 봤어?", "tags": ["greet"] },
    { "text": "왔어? 여기 앉아", "tags": ["greet"] },
    { "text": "짠! {name} 여기 있지롱", "tags": ["greet"] },
    { "text": "오늘 하루는 어땠어?", "tags": ["greet"] },
    { "text": "집사다! 집사다!", "tags": ["greet"] },
    { "text": "방금 집사 생각하고 있었어", "tags": ["greet"] },
    { "text": "오늘도 반가워", "tags": ["greet"] },
    { "text": "{name} 출석 완료!", "tags": ["greet"] },
    { "text": "인사는 머리 콩으로 할게", "tags": ["greet"] },

    { "text": "오랜만이야! 엄청 보고 싶었어", "tags": ["welcome_back"] },
    { "text": "집사다!! 진짜 집사다!!", "tags": ["welcome_back"] },
    { "text": "돌아와 줘서 고마워", "tags": ["welcome_back"] },
    { "text": "기다리면서 꾹꾹이 백 번 했어", "tags": ["welcome_back"] },
    { "text": "그동안 잘 지냈어?", "tags": ["welcome_back"] },
    { "text": "와아, 오랜만에 꼬리 풀가동!", "tags": ["welcome_back"] },
    { "text": "나는 잘 있었어, 집사는?", "tags": ["welcome_back"] },
    { "text": "보고 싶어서 방 청소도 했어", "tags": ["welcome_back"] },
    { "text": "다시 만나서 너무 좋아!", "tags": ["welcome_back"] },
    { "text": "언제든 와도 돼, 늘 여기 있어", "tags": ["welcome_back"] },
    { "text": "꿈에서 집사 봤는데 진짜 왔네", "tags": ["welcome_back"] },
    { "text": "오늘은 특별히 더 반가워", "tags": ["welcome_back"] },

    { "text": "냠냠, 잘 먹었어!", "tags": ["after_meal"] },
    { "text": "맛있었다~ 고마워 집사", "tags": ["after_meal"] },
    { "text": "배가 따끈따끈해", "tags": ["after_meal"] },
    { "text": "같이 먹으니까 더 맛있어", "tags": ["after_meal"] },
    { "text": "골골… 배부르고 행복해", "tags": ["after_meal"] },
    { "text": "한 그릇 뚝딱!", "tags": ["after_meal"] },
    { "text": "{name} 밥 시간 최고야", "tags": ["after_meal"] },
    { "text": "잘 먹었습니다냥", "tags": ["after_meal"] },
    { "text": "입가에 묻었나? 세수해야지", "tags": ["after_meal"] },
    { "text": "다 먹고 나니 졸려…", "tags": ["after_meal"] },
    { "text": "집사도 맛있게 먹었지?", "tags": ["after_meal"] },
    { "text": "고마워, 오늘도 같이 먹어 줘서", "tags": ["after_meal"] }
  ]
}
