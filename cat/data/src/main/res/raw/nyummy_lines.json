    { "text": "Good morning!", "tags": ["morning"] },
    { "text": "Mmm… still sleepy", "tags": ["morning"] },
    { "text": "The morning sun feels so warm", "tags": ["morning"] },
    { "text": "One big stretch— then let's go", "tags": ["morning"] },
    { "text": "So glad you're with me again today", "tags": ["morning", "day"] },
    { "text": "My tail sleeps in on mornings", "tags": ["morning"] },
    { "text": "Birds are chirping outside", "tags": ["morning", "day"] },
    { "text": "You're up! I just woke up too", "tags": ["morning"] },
    { "text": "Washed your face? I used my paws", "tags": ["morning"] },
    { "text": "What'll happen today?", "tags": ["morning", "day"] },
    { "text": "Yawn~ I had a nice dream", "tags": ["morning"] },
    { "text": "The morning air is so fresh", "tags": ["morning"] },
    { "text": "You've got this today!", "tags": ["morning", "day"] },
    { "text": "Rubbing my eyes… don't look", "tags": ["morning"] },
    { "text": "Morning nose boop for you", "tags": ["morning", "greet"] },
    { "text": "Your scent woke me up", "tags": ["morning"] },
    { "text": "But the blanket's the best…", "tags": ["morning"] },
    { "text": "Let's take it slow today", "tags": ["morning", "day"] },
    { "text": "Kneading goes great in the morning", "tags": ["morning"] },
    { "text": "The sun reached my cushion", "tags": ["morning", "day"] },

    { "text": "What were you up to?", "tags": ["day"] },
    { "text": "My tail keeps following me", "tags": ["day"] },
    { "text": "This cushion is just my size", "tags": ["day"] },
    { "text": "Dust is floating over there!", "tags": ["day"] },
    { "text": "My fur's extra shiny today, right?", "tags": ["day"] },
    { "text": "Bored? You can look at me", "tags": ["day"] },
    { "text": "Sunshine… I'm melting", "tags": ["day"] },
    { "text": "Knead, knead… doing your share too", "tags": ["day"] },
    { "text": "My ear itches. Scratching", "tags": ["day"] },
    { "text": "Did something just go by?", "tags": ["day"] },
    { "text": "I miss your voice", "tags": ["day"] },
    { "text": "What color is the sky today?", "tags": ["day"] },
    { "text": "I'll be right here. Take your time", "tags": ["day"] },
    { "text": "Cats can sleep 16 hours a day", "tags": ["day"] },
    { "text": "Take a little break too", "tags": ["day"] },
    { "text": "This room smells like us. Love it", "tags": ["day"] },
    { "text": "Tail tip, swish swish", "tags": ["day"] },
    { "text": "Anything fun going on?", "tags": ["day"] },
    { "text": "I'm being super serious… or not", "tags": ["day"] },
    { "text": "Time flies when I'm with you", "tags": ["day"] },
    { "text": "The floor is nice and cool", "tags": ["day"] },
    { "text": "Sniff detective, on the case!", "tags": ["day"] },
    { "text": "Hmm… what's that smell?", "tags": ["day"] },
    { "text": "Grooming is cat basics", "tags": ["day"] },
    { "text": "That was cool just now, right?", "tags": ["day"] },
    { "text": "Could I jump all the way up there?", "tags": ["day"] },
    { "text": "That cloud looks like a fish", "tags": ["day"] },
    { "text": "Afternoons are for lazing", "tags": ["day"] },
    { "text": "How are you feeling today?", "tags": ["day"] },
    { "text": "I feel great! No reason!", "tags": ["day"] },
    { "text": "My bandana suits me, right?", "tags": ["day"] },
    { "text": "This green bandana is my treasure", "tags": ["day"] },
    { "text": "Tail, hold still already", "tags": ["day"] },
    { "text": "Whiskers still in top shape", "tags": ["day"] },
    { "text": "Head tilt… what did you say?", "tags": ["day"] },
    { "text": "Ears up, listening", "tags": ["day"] },
    { "text": "I'm happy being a cat", "tags": ["day"] },
    { "text": "When you smile, I'm happy too", "tags": ["day"] },
    { "text": "Spacing out for a sec", "tags": ["day"] },
    { "text": "Doing nothing is work too", "tags": ["day"] },
    { "text": "A good shake. So refreshing", "tags": ["day"] },
    { "text": "The wind smells different", "tags": ["day"] },
    { "text": "Rainy days make me sleepier", "tags": ["day"] },
    { "text": "I wish I could see snow", "tags": ["day"] },
    { "text": "Spring smell, summer smell… all good", "tags": ["day"] },
    { "text": "Are your hands warm?", "tags": ["day"] },
    { "text": "Am I… heavier than I look?", "tags": ["day"] },
    { "text": "A hundred kneads today!", "tags": ["day"] },
    { "text": "Should I make a heart with my tail?", "tags": ["day"] },
    { "text": "Exploring every corner", "tags": ["day"] },
    { "text": "This spot is the best seat", "tags": ["day"] },
    { "text": "Over here! I'm right here!", "tags": ["day"] },
    { "text": "A good mood makes me purr", "tags": ["day"] },
    { "text": "Purrrr… hear that?", "tags": ["day", "tap"] },
    { "text": "Something like a butterfly flew by!", "tags": ["day"] },
    { "text": "Could've caught it… I let it go", "tags": ["day"] },
    { "text": "Can I show off my toe beans?", "tags": ["day"] },
    { "text": "Gonna take a quick nap", "tags": ["day"] },
    { "text": "Doz… no, I wasn't dozing", "tags": ["day"] },
    { "text": "Whoa! It was just a dream", "tags": ["day"] },
    { "text": "Take a big deep breath too", "tags": ["day"] },
    { "text": "It's okay to go slow", "tags": ["day"] },
    { "text": "You're doing great today", "tags": ["day"] },
    { "text": "Thanks for visiting my room", "tags": ["day"] },
    { "text": "I feel at ease here", "tags": ["day"] },
    { "text": "Cats don't have Mondays", "tags": ["day"] },
    { "text": "Count my tails. Just one", "tags": ["day"] },
    { "text": "{name} is cute again today", "tags": ["day"] },
    { "text": "Something rustled", "tags": ["day"] },
    { "text": "Ten stretches a day", "tags": ["day"] },
    { "text": "My cushion is toasty warm", "tags": ["day"] },
    { "text": "I get extra excited when you watch", "tags": ["day"] },
    { "text": "How much wiggling today?", "tags": ["day"] },
    { "text": "My fur's all puffed up", "tags": ["day"] },
    { "text": "Yawns are contagious, yawn~", "tags": ["day", "night"] },
    { "text": "Wanna play slow-blink with me?", "tags": ["day"] },
    { "text": "A slow blink means I like you", "tags": ["day"] },
    { "text": "We're close, right?", "tags": ["day"] },
    { "text": "You're my best friend", "tags": ["day"] },
    { "text": "Me here, you there. Just right", "tags": ["day"] },
    { "text": "My tail wants to dance", "tags": ["day"] },
    { "text": "Today's mood: squishy", "tags": ["day"] },
    { "text": "Today's mood: fluffy", "tags": ["day"] },
    { "text": "Today's mood: roly-poly", "tags": ["day"] },
    { "text": "I'd win a sniffing contest for sure", "tags": ["day"] },
    { "text": "Loafing right now", "tags": ["day", "night"] },
    { "text": "Too comfy to get up", "tags": ["day", "night"] },

    { "text": "It's night already", "tags": ["night"] },
    { "text": "Sleepy… eyes closing", "tags": ["night"] },
    { "text": "Nod… nod…", "tags": ["night"] },
    { "text": "You should get to bed too", "tags": ["night"] },
    { "text": "You worked hard today", "tags": ["night"] },
    { "text": "I like how quiet nights are", "tags": ["night"] },
    { "text": "Tell me if you see stars", "tags": ["night"] },
    { "text": "Loaf position is the warmest", "tags": ["night"] },
    { "text": "Let's play in our dreams", "tags": ["night"] },
    { "text": "Good night", "tags": ["night"] },
    { "text": "What a cozy night", "tags": ["night"] },
    { "text": "Yawn… see you tomorrow", "tags": ["night"] },
    { "text": "I'll guard this room tonight", "tags": ["night"] },
    { "text": "Sleepy, but you woke me right up", "tags": ["night", "greet"] },
    { "text": "Up late, huh", "tags": ["night"] },
    { "text": "Have something warm, then sleep", "tags": ["night"] },
    { "text": "Anything good happen today?", "tags": ["night"] },
    { "text": "I could fall asleep in a blink", "tags": ["night"] },
    { "text": "Zzz… zzz…", "tags": ["night"] },
    { "text": "Tucked in? Cover your tummy", "tags": ["night"] },
    { "text": "Making a blanket out of my tail", "tags": ["night"] },
    { "text": "The night breeze feels cool", "tags": ["night"] },
    { "text": "The moon is peeking into the room", "tags": ["night"] },
    { "text": "One stretch before bed", "tags": ["night"] },
    { "text": "I'm already at dreamland's door", "tags": ["night"] },

    { "text": "Hey, that tickles!", "tags": ["tap"] },
    { "text": "Hehe, pet me again", "tags": ["tap"] },
    { "text": "Boing! You startled me", "tags": ["tap"] },
    { "text": "Right there, right there!", "tags": ["tap"] },
    { "text": "Mrrow~", "tags": ["tap"] },
    { "text": "Forehead pets are the best", "tags": ["tap"] },
    { "text": "Squish me, I squish back", "tags": ["tap"] },
    { "text": "Your hand smells nice", "tags": ["tap"] },
    { "text": "You rang?", "tags": ["tap"] },
    { "text": "Hm? Did you call me?", "tags": ["tap"] },
    { "text": "Surprised how squishy I am?", "tags": ["tap"] },
    { "text": "Boop! Right back at you", "tags": ["tap"] },
    { "text": "Chin scratches are even better", "tags": ["tap"] },
    { "text": "Gently on the tail, please", "tags": ["tap"] },
    { "text": "Hehe, one more time!", "tags": ["tap"] },
    { "text": "Today's petting: approved!", "tags": ["tap"] },
    { "text": "Out of nowhere? I like it!", "tags": ["tap"] },
    { "text": "{name} fully charged", "tags": ["tap"] },
    { "text": "Are you charged up too?", "tags": ["tap"] },
    { "text": "Thank you for the pets", "tags": ["tap"] },
    { "text": "I'm melting right now", "tags": ["tap"] },
    { "text": "Do the back of my head too", "tags": ["tap"] },
    { "text": "Want my paw? Here!", "tags": ["tap"] },
    { "text": "Mew!", "tags": ["tap"] },
    { "text": "Special permission, just this once", "tags": ["tap"] },
    { "text": "Eek, you startled me", "tags": ["tap"] },
    { "text": "You were gonna say I'm cute, right?", "tags": ["tap"] },
    { "text": "You like me, right? I can tell", "tags": ["tap"] },
    { "text": "Purr purr purr…", "tags": ["tap"] },
    { "text": "One more and I'll knead for you", "tags": ["tap"] },
    { "text": "Ah, that's my tummy… careful", "tags": ["tap"] },
    { "text": "Pets like this? Come every day", "tags": ["tap"] },
    { "text": "Your hands are like magic", "tags": ["tap"] },
    { "text": "My tail's wagging on its own", "tags": ["tap"] },
    { "text": "{name} mood boost!", "tags": ["tap"] },

    { "text": "Whoa, what's gotten into you?!", "tags": ["tap_burst"] },
    { "text": "Stop touching me…", "tags": ["tap_burst"] },
    { "text": "Mrraow! I said quit it", "tags": ["tap_burst"] },
    { "text": "How many times is that now?", "tags": ["tap_burst"] },
    { "text": "Hands off", "tags": ["tap_burst"] },
    { "text": "I'm mad now. A little.", "tags": ["tap_burst"] },
    { "text": "…(tail thump) Stop poking", "tags": ["tap_burst:tail_thump"] },
    { "text": "Can't you tell from my tail? Annoyed", "tags": ["tap_burst:tail_thump"] },
    { "text": "Sigh… seriously", "tags": ["tap_burst:tail_thump"] },
    { "text": "…I'll remember that hand", "tags": ["tap_burst:glare"] },
    { "text": "Hmph. Not playing with you", "tags": ["tap_burst:glare"] },
    { "text": "Can't you see me glaring?", "tags": ["tap_burst:glare"] },
    { "text": "See how flat my ears are?", "tags": ["tap_burst:ears_back"] },
    { "text": "Stop~ my ears are folding", "tags": ["tap_burst:ears_back"] },
    { "text": "This is a warning", "tags": ["tap_burst:ears_back"] },
    { "text": "Whoa, what's gotten into you?!", "tags": ["tap_burst:recoil"] },
    { "text": "Yikes! What was that?", "tags": ["tap_burst:recoil"] },
    { "text": "Wh-what, what?!", "tags": ["tap_burst:recoil"] },
    { "text": "You startled me!", "tags": ["tap_burst:recoil"] },
    { "text": "Want a cat punch?", "tags": ["tap_burst:swat"] },
    { "text": "Fluffy paw incoming!", "tags": ["tap_burst:swat"] },
    { "text": "Swat! Final warning", "tags": ["tap_burst:swat"] },

    { "text": "You're here!", "tags": ["greet"] },
    { "text": "Hi there!", "tags": ["greet"] },
    { "text": "I was waiting for you", "tags": ["greet"] },
    { "text": "Welcome! I missed you", "tags": ["greet"] },
    { "text": "You came again today!", "tags": ["greet"] },
    { "text": "I heard your footsteps", "tags": ["greet"] },
    { "text": "Hi! Did you see my tail wag?", "tags": ["greet"] },
    { "text": "You're here? Sit right here", "tags": ["greet"] },
    { "text": "Ta-da! Here's {name}!", "tags": ["greet"] },
    { "text": "How was your day?", "tags": ["greet"] },
    { "text": "It's you! It's you!", "tags": ["greet"] },
    { "text": "I was just thinking about you", "tags": ["greet"] },
    { "text": "Happy to see you today too", "tags": ["greet"] },
    { "text": "{name}, present!", "tags": ["greet"] },
    { "text": "Hello head bonk!", "tags": ["greet"] },

    { "text": "Long time no see! Missed you so much", "tags": ["welcome_back"] },
    { "text": "It's you!! It's really you!!", "tags": ["welcome_back"] },
    { "text": "Thank you for coming back", "tags": ["welcome_back"] },
    { "text": "I kneaded 100 times while waiting", "tags": ["welcome_back"] },
    { "text": "Have you been doing okay?", "tags": ["welcome_back"] },
    { "text": "Wow, tail at full power again!", "tags": ["welcome_back"] },
    { "text": "I was okay. How about you?", "tags": ["welcome_back"] },
    { "text": "Missed you, so I tidied my room", "tags": ["welcome_back"] },
    { "text": "So happy to see you again!", "tags": ["welcome_back"] },
    { "text": "Come anytime. I'm always here", "tags": ["welcome_back"] },
    { "text": "Dreamed of you, and here you are", "tags": ["welcome_back"] },
    { "text": "Extra happy to see you today", "tags": ["welcome_back"] },

    { "text": "Nom nom, that was yummy!", "tags": ["after_meal"] },
    { "text": "Delicious~ thank you", "tags": ["after_meal"] },
    { "text": "My tummy's nice and warm", "tags": ["after_meal"] },
    { "text": "Food tastes better together", "tags": ["after_meal"] },
    { "text": "Purr… full and happy", "tags": ["after_meal"] },
    { "text": "Bowl cleaned in a flash!", "tags": ["after_meal"] },
    { "text": "{name} loves mealtime", "tags": ["after_meal"] },
    { "text": "That was purr-fect", "tags": ["after_meal"] },
    { "text": "Something on my mouth? Time to wash", "tags": ["after_meal"] },
    { "text": "All done, and now I'm sleepy…", "tags": ["after_meal"] },
    { "text": "Did you enjoy your meal too?", "tags": ["after_meal"] },
    { "text": "Thanks for eating with me today", "tags": ["after_meal"] }
  ]
}
