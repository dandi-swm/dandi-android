<?xml version="1.0" encoding="utf-8"?>
<!--
  냐미 위젯 미리보기(점심 기다림 B, 12일). 위젯 고르기 화면과, 위젯을 놓고 앱이 처음 그리기 전 잠깐 보인다.
  배치는 widget_nyummy와 같다. 문구와 스트릭 글자는 언어에 따라 둘 중 하나만 보인다(values*/integers.xml).
  - 한국어·일본어: 미리 그린 글자 그림(widget_preview_copy, widget_preview_streak, 일본어판은 drawable-ja-xxhdpi)
  - 그 밖(기본 영어): 문자열 리소스를 기기 글꼴로. 크기·줄 높이는 NyummyWidgetTextPainter와 같다(제목 32/36, 설명 17/21, 둘 사이 4, 스트릭 15/19).
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_card_outline"
    android:clipToOutline="true">

    <!-- 위젯은 런처가 AppCompat 없이 프레임워크 ImageView로 그려서 app:tint가 먹지 않는다. -->
    <ImageView
        android:id="@+id/widget_card"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="fitXY"
        android:src="@drawable/widget_card_shape"
        android:tint="@color/widget_bg_sky"
        tools:ignore="UseAppTint" />

    <ImageView
        android:id="@+id/widget_glow"
        android:layout_width="300dp"
        android:layout_height="300dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="-54dp"
        android:layout_marginEnd="-60dp"
        android:contentDescription="@null"
        android:src="@drawable/widget_glow" />

    <ImageView
        android:id="@+id/widget_character"
        android:layout_width="188dp"
        android:layout_height="188dp"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="-2dp"
        android:layout_marginBottom="-8dp"
        android:contentDescription="@null"
        android:scaleType="fitCenter"
        android:src="@drawable/widget_nyummy_wait_b" />

    <ImageView
        android:id="@+id/widget_copy"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_marginStart="22dp"
        android:layout_marginTop="24dp"
        android:contentDescription="@null"
        android:src="@drawable/widget_preview_copy"
        android:visibility="@integer/widget_preview_image_visibility" />

    <!-- 글자 크기는 위젯 본문처럼 dp로 고정한다(기기 글꼴 크기 설정을 따르면 냐미 그림에 겹친다). -->
    <LinearLayout
        android:id="@+id/widget_copy_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_marginStart="22dp"
        android:layout_marginTop="24dp"
        android:orientation="vertical"
        android:visibility="@integer/widget_preview_text_visibility">

        <TextView
            android:id="@+id/widget_copy_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:includeFontPadding="false"
            android:lineHeight="36dp"
            android:text="@string/widget_preview_title"
            android:textColor="@android:color/white"
            android:textSize="32dp"
            tools:ignore="SpUsage" />

        <TextView
            android:id="@+id/widget_copy_sub"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="sans-serif-medium"
            android:includeFontPadding="false"
            android:lineHeight="21dp"
            android:text="@string/widget_preview_sub"
            android:textColor="@android:color/white"
            android:textSize="17dp"
            tools:ignore="SpUsage" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/widget_streak"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:layout_marginStart="22dp"
        android:layout_marginBottom="14dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/widget_streak_icon"
            android:layout_width="19dp"
            android:layout_height="19dp"
            android:contentDescription="@null"
            android:src="@drawable/widget_streak_icon" />

        <ImageView
            android:id="@+id/widget_streak_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="7dp"
            android:contentDescription="@null"
            android:src="@drawable/widget_preview_streak"
            android:visibility="@integer/widget_preview_image_visibility" />

        <TextView
            android:id="@+id/widget_streak_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="7dp"
            android:fontFamily="sans-serif-medium"
            android:includeFontPadding="false"
            android:lineHeight="19dp"
            android:text="@string/widget_preview_streak"
            android:textColor="@android:color/white"
            android:textSize="15dp"
            android:visibility="@integer/widget_preview_text_visibility"
            tools:ignore="SpUsage" />
    </LinearLayout>

</FrameLayout>
