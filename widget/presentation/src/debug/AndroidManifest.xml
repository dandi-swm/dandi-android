<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application>
        <!-- debug 전용: adb로 위젯 상태·시안을 고정해 그린다(시안 비교용). adb가 보내야 해서 내보낸다. -->
        <receiver
            android:name="com.dandi.nyummy.widget.presentation.NyamiWidgetDebugReceiver"
            android:exported="true"
            tools:ignore="ExportedReceiver">
            <intent-filter>
                <action android:name="com.dandi.nyummy.widget.debug.SHOW" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
