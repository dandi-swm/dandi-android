default_platform(:android)

ROOT_DIR = File.expand_path("..", __dir__)
AAB_PATH = File.join(ROOT_DIR, "app/build/outputs/bundle/release/app-release.aab")

# versionCode 를 비교할 Play 트랙. 트랙 사이 승격으로 더 큰 versionCode 가 다른 트랙에 있을 수 있다.
VERSION_CODE_TRACKS = %w[internal alpha beta production].freeze

# release 빌드와 업로드에 필요한 키와, 빌드 스크립트가 실제로 읽는 곳.
#   :local_or_env      local.properties 값이 비었거나 없으면 환경변수 (app, auth/presentation)
#   :local_key_or_env  local.properties 에 키가 있으면 빈 값이어도 그 값만, 키가 없을 때만 환경변수
#                      (common/data 의 configValue: API_BASE_URL_PROD)
#   :env_only      환경변수만 (Appfile 의 Play 서비스 계정 JSON 경로)
REQUIRED_KEYS = {
  "RELEASE_STORE_FILE" => :local_or_env,
  "RELEASE_STORE_PASSWORD" => :local_or_env,
  "RELEASE_KEY_ALIAS" => :local_or_env,
  "RELEASE_KEY_PASSWORD" => :local_or_env,
  "API_BASE_URL_PROD" => :local_key_or_env,
  "META_APP_ID" => :local_or_env,
  "META_CLIENT_TOKEN" => :local_or_env,
  "KAKAO_NATIVE_APP_KEY" => :local_or_env,
  "GOOGLE_WEB_CLIENT_ID" => :local_or_env,
  "AIRBRIDGE_SDK_TOKEN" => :local_or_env,
  "PLAY_SERVICE_ACCOUNT_JSON_PATH" => :env_only
}.freeze

# local.properties 를 key=value 로만 읽는다(값은 출력하지 않는다).
def local_properties
  path = File.join(ROOT_DIR, "local.properties")
  return {} unless File.exist?(path)

  File.readlines(path, chomp: true).each_with_object({}) do |line, props|
    next if line.strip.empty? || line.lstrip.start_with?("#", "!")

    key, value = line.split(/\s*[=:]\s*/, 2)
    props[key.strip] = value.to_s.strip if key
  end
end

def missing_required_keys
  props = local_properties
  present = lambda { |value| !value.nil? && !value.strip.empty? }
  REQUIRED_KEYS.reject do |key, source|
    case source
    when :env_only then present.call(ENV[key])
    when :local_key_or_env then props.key?(key) ? present.call(props[key]) : present.call(ENV[key])
    else present.call(props[key]) || present.call(ENV[key])
    end
  end.keys
end

# 경로로 받는 키가 실제 파일을 가리키는지 본다. 경로 값은 출력하지 않는다.
# 상대 경로의 기준 디렉터리는 키를 읽는 쪽을 따른다.
#   RELEASE_STORE_FILE              app 모듈 (app/build.gradle.kts 의 Gradle file())
#   PLAY_SERVICE_ACCOUNT_JSON_PATH  저장소 루트 (fastlane 이 Appfile 경로를 푸는 작업 디렉터리)
FILE_PATH_KEYS = {
  "RELEASE_STORE_FILE" => File.join(ROOT_DIR, "app"),
  "PLAY_SERVICE_ACCOUNT_JSON_PATH" => ROOT_DIR
}.freeze

def missing_key_files
  props = local_properties
  FILE_PATH_KEYS.reject do |key, base_dir|
    value = key == "PLAY_SERVICE_ACCOUNT_JSON_PATH" ? ENV[key] : (props[key].to_s.strip.empty? ? ENV[key] : props[key])
    File.file?(File.expand_path(value.to_s.strip, base_dir))
  end.keys
end

VERSION_NAME_PATTERN = /\A\d+\.\d+\.\d+\z/

# 출시 이름 안에 버전 이름이 온전한 토큰으로 들어 있는지 본다("16 (2.2.2)" 는 2.2.2 와 일치, "2.2.20" 은 불일치).
def release_name_matches?(release_name, version_name)
  release_name.to_s.match?(/(?<![\d.])#{Regexp.escape(version_name)}(?![\d.])/)
end

platform :android do
  desc "release AAB 를 만들어 Play 내부 테스트 트랙에 올린다(스토어 문구, 스크린샷, 변경 사항은 올리지 않음)"
  lane :internal do |options|
    version_name = options[:version_name].to_s.strip
    version_name = ENV["NYUMMY_VERSION_NAME"].to_s.strip if version_name.empty?
    if version_name.empty?
      UI.user_error!("버전 이름이 없습니다. version_name:2.2.3 옵션이나 NYUMMY_VERSION_NAME 환경변수로 주세요.")
    end
    unless version_name.match?(VERSION_NAME_PATTERN)
      UI.user_error!("버전 이름은 숫자.숫자.숫자 형식이어야 합니다(앞의 v 없이, 예: 2.2.3): #{version_name}")
    end

    missing = missing_required_keys
    unless missing.empty?
      UI.user_error!(
        "release 빌드에 필요한 키가 없습니다: #{missing.join(', ')} " \
        "(PLAY_SERVICE_ACCOUNT_JSON_PATH 는 환경변수, 나머지는 local.properties 또는 환경변수)"
      )
    end

    missing_files = missing_key_files
    unless missing_files.empty?
      UI.user_error!("키가 가리키는 파일이 없습니다: #{missing_files.join(', ')}")
    end

    # 비어 있는 트랙은 빈 배열로 돌아와 건너뛰어진다. 조회 실패는 그대로 lane 실패로 둔다.
    latest = VERSION_CODE_TRACKS.filter_map do |track|
      google_play_track_version_codes(track: track).map(&:to_i).max
    end.max
    # Play 에 같은 버전 이름의 출시가 있으면 멈춘다. 출시 이름 문자열에 기대는 최선의 검사다.
    # 조회 실패는 그대로 lane 실패로 둔다.
    VERSION_CODE_TRACKS.each do |track|
      clash = google_play_track_release_names(track: track).find { |name| release_name_matches?(name, version_name) }
      UI.user_error!("Play #{track} 트랙에 이미 버전 이름 #{version_name} 의 출시가 있습니다: #{clash}") if clash
    end

    gradle_properties = { "nyummy.versionName" => version_name }
    UI.message("versionName #{version_name}")
    if latest
      gradle_properties["nyummy.versionCode"] = latest + 1
      UI.message("versionCode #{latest + 1} (Play 트랙 최신 #{latest})")
    else
      UI.message("Play 트랙이 비어 app/build.gradle.kts 기본 versionCode 사용")
    end

    # 운영 키가 든 release 빌드 결과를 Gradle 빌드 캐시에 남기지 않는다.
    gradle(
      task: ":app:bundleRelease",
      flags: "--no-build-cache",
      project_dir: ROOT_DIR,
      properties: gradle_properties
    )

    upload_to_play_store(
      track: "internal",
      aab: AAB_PATH,
      # 출시 이름. 주지 않으면 supply 가 Appfile 값(없으면 nil)을 써서 Play 기본 이름이 붙는다.
      version_name: version_name,
      skip_upload_apk: true,
      skip_upload_metadata: true,
      skip_upload_changelogs: true,
      skip_upload_images: true,
      skip_upload_screenshots: true
    )
  end
end
