<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="onboarding_character_description">道で出会ったネコ</string>
    <string name="onboarding_skip">スキップ</string>
    <string name="onboarding_tap_to_continue">タップして続ける</string>
    <string name="onboarding_speaker_user">わたし</string>
    <string name="onboarding_speaker_unknown_cat">\?\?\?</string>

    <!-- 1. 퇴근길 골목 -->
    <string name="onboarding_line_alley_1">今日もごはんを適当に済ませた一日だった。</string>
    <string name="onboarding_line_alley_2">とぼとぼと、街灯がひとつだけ灯る路地を抜けて家へ帰る途中。</string>

    <!-- 2. 상자 속 길냥이 -->
    <string name="onboarding_line_meet_1">…にゃあ。</string>
    <string name="onboarding_line_meet_2">路地の隅の段ボール箱の中から、小さなネコがじっとこちらを見ている。</string>
    <string name="onboarding_line_meet_3">どうしよう？</string>
    <string name="onboarding_choice_hand">しゃがんで手を差し出す</string>
    <string name="onboarding_choice_snack">カバンからおやつを出す</string>
    <string name="onboarding_line_hand_1">…こんにちは。こわくないよ。</string>
    <string name="onboarding_line_hand_2">ネコはそろそろと箱から出てきて、指先のにおいをくんくん嗅いでいる。</string>
    <string name="onboarding_line_snack_1">おなかすいてる？これ食べる？</string>
    <string name="onboarding_line_snack_2">ネコはおやつをもぐもぐ食べると、じっとこちらを見上げた。</string>

    <!-- 3. 간택 -->
    <string name="onboarding_line_chosen_1">そして、わたしの手に頭をぐりぐりとこすりつけた。</string>
    <string name="onboarding_line_chosen_2">…どうやら、選ばれてしまったみたいだ。</string>

    <!-- 4. 서비스 소개 -->
    <string name="onboarding_line_talk_1">ねえ、ごはんちゃんと食べてるにゃ？</string>
    <string name="onboarding_line_talk_2">…え？今、ネコがしゃべった？</string>
    <string name="onboarding_line_talk_3">これからは、食べたものを写真で見せて。いっしょに食べてあげる。</string>
    <string name="onboarding_line_talk_4">ちゃんと食べてくれたら、ぼくもすくすく大きくなるにゃ。適当に食べたら…ぼくもへろへろになっちゃう。</string>
    <string name="onboarding_line_talk_5">だから今日から、いっしょに食べよう！</string>
    <string name="onboarding_line_talk_6">いっしょにごはんを食べるネコか。…よし、やってみよう。</string>

    <!-- 5. 이름 짓기 -->
    <string name="onboarding_line_name_1">でも…ぼく、まだ名前がないんだ。</string>
    <string name="onboarding_line_name_2">つけてくれる？</string>
    <string name="onboarding_name_label">ネコの名前</string>
    <string name="onboarding_name_placeholder">例：ニャミ</string>
    <string name="onboarding_name_helper">%1$d文字までつけられます</string>
    <string name="onboarding_name_error_empty">名前をつけてください</string>
    <string name="onboarding_name_error_too_long">名前は%1$d文字までつけられます</string>
    <string name="onboarding_name_submit">この名前にする</string>

    <!-- 6. 이름을 받은 고양이 -->
    <string name="onboarding_line_named_1">「%1$s」…！</string>
    <string name="onboarding_line_named_2">気に入った！今日からぼくは%1$sだよ。</string>
    <string name="onboarding_line_named_3">これからよろしくね、ご主人！</string>
    <string name="onboarding_start">いっしょに始める</string>

    <!-- 7. 평소 식사 시각 -->
    <string name="onboarding_line_meal_time_1">ごはんの時間になったら教えてあげる。いつもはいつ食べてる？</string>
    <string name="onboarding_meal_done">この時間に教えて</string>
</resources>
